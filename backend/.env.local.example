# Salin file ini ke .env.local, lalu isi nilai aslinya (JANGAN commit .env.local ke git)

# Connection string dari Neon dashboard (project database BARU, jangan pakai punya Vale)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# String rahasia acak buat nandatangan JWT — generate sendiri, jangan pakai contoh ini.
# Cara generate cepat: jalankan `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=ganti-dengan-string-acak-panjang
